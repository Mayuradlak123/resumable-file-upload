# ==============================================================================
# Resumable Upload — Example Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust as needed:
#     cp .env.example .env
#
# Only the FastAPI demo (examples/fastapi_demo) reads these. The package itself
# takes no configuration from the environment — everything is passed to
# UploadManager explicitly.

# --- Storage ------------------------------------------------------------------
# Directory that holds {upload_id}/chunks/*.part, metadata.json and completed/.
# Relative paths are resolved against the process working directory.
UPLOAD_DIR="./uploads"

# --- Chunking -----------------------------------------------------------------
# Chunk size used when the client does not specify one, in bytes (5 MiB).
DEFAULT_CHUNK_SIZE=5242880

# Largest chunk size a client is allowed to request, in bytes (100 MiB).
# This is the practical cap on how much a single request buffers in memory.
MAX_CHUNK_SIZE=104857600

# Delete the per-chunk working files once the final file is assembled.
# Set to false to keep chunks around for debugging.
CLEANUP_CHUNKS_ON_COMPLETE=true

# --- Server -------------------------------------------------------------------
HOST="127.0.0.1"
PORT=8000

# Comma-separated list of allowed browser origins; "*" allows all.
# Narrow this before exposing the demo anywhere real.
CORS_ORIGINS="*"
